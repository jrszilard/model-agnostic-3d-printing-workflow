# Copy this file OUTSIDE any git repository, e.g.:
#   mkdir -p ~/.config/3d-printing-workflow
#   cp prusalink.env.example ~/.config/3d-printing-workflow/prusalink.env
#
# Or set PRUSALINK_ENV=/path/to/your/prusalink.env in your shell or consumer env.sh.

PRUSALINK=your-printer.local
PRUSALINK_USER=maker
PRUSALINK_PASSWORD=<password>
# PRUSALINK_KEY=<api-key>          # Older firmware only; sent as X-Api-Key
PRUSALINK_STORAGE=usb
PRUSALINK_NOZZLE=HF0.4
