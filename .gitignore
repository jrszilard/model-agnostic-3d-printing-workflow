# Build outputs & print jobs (never commit; tiny synthetic slicer test fixture exempt)
build/
*.gcode
*.gco
!platform/pipeline/slice/testdata/*.gcode

# Local credentials & environment files (only *.env.example is tracked)
.env
.env.*
*.env
!*.env.example
prusalink.env

# Reference photos, scans, and media
photoref/
*.mp4
*.mov
*.avi

# Python & tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.venv-*/
*.egg-info/

# Local AI / editor state (keep workspace-local paths out of the public repo)
.claude/
.cursor/
.DS_Store
*.swp
*.swo
*~

# Draft / prototype / temporary CAD artifacts (canonical untracked namespace)
**/*--draft-*.stl
**/*--draft-*.step
**/*--opt[0-9]*.stl
**/*--opt[0-9]*.step
**/*--test[0-9]*.stl
**/*--test[0-9]*.step
**/*--proto*.stl
**/*--proto*.step

# Assembly / mockup / visualisation geometry (regenerable, not sliced or printed)
**/stl/assembly/
**/step/assembly/
**/stl/mockup/
**/step/mockup/
**/mockup-*.stl
**/mockup-*.step
**/massing-*.stl
**/massing-*.step
**/_preview-*.stl
**/_preview-*.step
**/proto-*.stl
**/proto-*.step

# Shipped revisions under releases/ are immutable evidence
!**/releases/**/*.stl
!**/releases/**/*.step
!**/releases/**/*.3mf
!**/releases/**/*.png
!**/releases/**/*.md
!**/releases/**/*.txt

# Machine-local verification stamps
**/verify.stamp
